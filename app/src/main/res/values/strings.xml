    <string name="service_label">跳一跳助手 · 手势服务</string>
    <string name="service_description">按你选定的起点和终点注入一次按压手势来控制跳跃距离。不读取屏幕内容，不联网，不需要 Root。</string>

    <!-- ==================== 主界面 ==================== -->
