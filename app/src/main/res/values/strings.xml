<resources>
    <string name="app_name">跳一跳助手</string>
    <string name="service_label">跳一跳助手 · 手势服务</string>
    <string name="service_description">按你选定的两个点（起点、终点）注入一次按压手势来控制跳跃距离。不读取屏幕内容，不联网，不需要 Root。</string>

    <!-- ==================== 主界面 ==================== -->
    <string name="main_title">跳一跳助手</string>
    <string name="main_subtitle">无障碍手势版 · 无需 Root · 不截屏</string>

    <string name="status_ok">服务状态：已启用</string>
    <string name="status_no">服务状态：未启用</string>
    <string name="status_hint_no">请先到「设置 → 无障碍」里启用本服务</string>
    <string name="status_hint_ok">服务正常，可以显示浮层了</string>

    <string name="btn_open_settings">去开启无障碍服务</string>
    <string name="btn_show_overlay">显示浮层</string>
    <string name="btn_close">退出</string>

    <string name="main_howto_title">使用步骤</string>
    <string name="main_howto_body">1. 打开微信「跳一跳」，停在等待按压的状态\n2. 切回本应用，点「显示浮层」\n3. 点浮层上的【选点】，然后：\n     · 先点一下棋子（起点）\n     · 再点一下目标方块（终点）\n4. 点【跳】，程序会自动完成这次按压\n5. 跳完浮层自动复位，重复第 3 步</string>

    <string name="main_param_title">参数</string>
    <string name="main_coeff_label">按压系数（毫秒/像素）：</string>
    <string name="main_coeff_hint">1080 宽屏建议 1.39；跳不到位就微调</string>
    <string name="btn_save">保存</string>
    <string name="btn_reset_default">恢复默认</string>
    <string name="main_param_saved">参数已保存</string>
    <string name="main_param_bad">请输入 0.2 ~ 5 之间的数字</string>

    <string name="main_device_title">关于按压系数（重要）</string>
    <string name="main_device_body">系数 = 每像素需要按住的毫秒数，它决定了跳多远。\n\n默认 1.392 是按 1080 宽屏的实测值预设的，属于「通用但不精确」。\n\n**推荐做法：让程序自己测出来**\n点浮层上的【校准】，按提示做一次：\n  点起点 → 点终点 → 点【跳】→ 点棋子实际停下的位置\n程序会立刻算出你这台机器的真实系数并永久保存。\n这样就跟分辨率完全无关了，换屏幕、换设备重测一次即可。\n\n跳得偏短就把系数调大，偏长就调小，每次改 0.02~0.05。</string>

    <string name="main_warn_title">说明</string>
    <string name="main_warn_body">· 半自动：每次需要你点两个点\n· 仅在你授权无障碍服务后工作，可随时关闭\n· 不申请网络权限，无法上传任何数据\n· 不读取屏幕像素，不做任何截图</string>

