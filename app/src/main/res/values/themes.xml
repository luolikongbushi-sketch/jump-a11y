<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JumpA11y" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
    </style>

    <!-- Flat, quiet button: no elevation, one accent outline, generous horizontal padding. -->
    <style name="Widget.JumpA11y.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/bg_btn</item>
    </style>

    <style name="Widget.JumpA11y.Button.Accent">
        <item name="android:textColor">@color/accent</item>
        <item name="android:background">@drawable/bg_btn_accent</item>
    </style>
</resources>
