<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      DayNight 会让 Android 按当前是浅色还是深色自动挑 values/ 或 values-night/ 里的颜色，
      这里就不用写两套 style 了。
    -->
    <style name="Theme.JumpA11y" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
