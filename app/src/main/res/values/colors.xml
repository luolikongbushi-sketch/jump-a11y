<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal dark palette.

  Rules followed:
   - one accent hue (soft cyan) carries all interactive meaning
   - text uses a three-step ramp instead of many greys, so hierarchy reads at a glance
   - status colours are muted rather than saturated, to keep the dark surface calm
-->
<resources>
    <!-- surfaces -->
    <color name="bg">#FF0B0E13</color>          <!-- app background -->
    <color name="surface">#FF141A22</color>     <!-- cards, panel -->
    <color name="surface_hi">#FF1C232D</color>  <!-- inputs, subtle fills -->
    <color name="stroke">#FF232C38</color>      <!-- 1dp hairlines -->

    <!-- text ramp -->
    <color name="text">#FFE6EDF3</color>        <!-- primary -->
    <color name="text_dim">#FF8B98A5</color>    <!-- secondary -->
    <color name="text_faint">#FF5C6773</color>  <!-- hints, captions -->

    <!-- accent + status (muted on purpose) -->
    <color name="accent">#FF6EE7F5</color>
    <color name="ok">#FF7BE0A8</color>
    <color name="warn">#FFF5C97F</color>
    <color name="bad">#FFF5857F</color>

    <!-- overlay markers -->
    <color name="marker_start">#FF6EE7F5</color>
    <color name="marker_end">#FFF5A97F</color>
    <color name="marker_landing">#FF7BE0A8</color>
</resources>
