<?xml version="1.0" encoding="utf-8"?>
<!--
  暗色配色。

  几条自己定的规则：
   - 只用一种强调色（柔和的青），所有能点的东西都用它，不混别的色
   - 文字分三级而不是一堆灰，层级一眼能看出来
   - 状态色压低饱和度，免得在暗色底上跳出来刺眼
-->
<resources>
    <!-- 背景层 -->
    <color name="bg">#FF0B0E13</color>          <!-- 应用背景 -->
    <color name="surface">#FF141A22</color>     <!-- 卡片、面板 -->
    <color name="surface_hi">#FF1C232D</color>  <!-- 输入框等 -->
    <color name="stroke">#FF232C38</color>      <!-- 1dp 分隔线 -->

    <!-- 文字三级 -->
    <color name="text">#FFE6EDF3</color>        <!-- 主要 -->
    <color name="text_dim">#FF8B98A5</color>    <!-- 次要 -->
    <color name="text_faint">#FF5C6773</color>  <!-- 提示、说明 -->

    <!-- 强调色和状态色 -->
    <color name="accent">#FF6EE7F5</color>
    <color name="ok">#FF7BE0A8</color>
    <color name="warn">#FFF5C97F</color>
    <color name="bad">#FFF5857F</color>

    <!-- 浮层上的标记 -->
    <color name="marker_start">#FF6EE7F5</color>
    <color name="marker_end">#FFF5A97F</color>
    <color name="marker_landing">#FF7BE0A8</color>
</resources>
